# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
OPENAI_API_KEY=sk-...

# Optional — dùng provider OpenAI-compatible khác (VD DeepSeek).
# Khi set OPENAI_BASE_URL, RAGAS dùng embedding local (bge-m3) vì provider có thể không có embeddings API.
# OPENAI_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
